{
  "name": "lionbox-desktop",
  "productName": "LionBox",
  "version": "2.3.15.12",
  "description": "LionBox desktop client for Windows and macOS — VLESS & Shadowsocks over xray-core",
  "repository": {
    "type": "git",
    "url": "https://github.com/satminpaing1/New-LionBox.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "fetch-core": "node fetch-core.js",
    "dist": "electron-builder --win --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lionbox.desktop",
    "productName": "LionBox",
    "files": ["main.js", "preload.js", "bridge.js", "xray-config.js", "fetch-core.js", "package.json", "ui/**/*"],
    "extraResources": ["core/"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
